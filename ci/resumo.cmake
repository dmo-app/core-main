# Resumo do gate (plano de testes T02) e inventario dos testes (regra de ferro 4). Corre depois do ctest:
#   cmake -DSRC=<codigo> -DBUILD=<build> -DJUNIT=<build>/gate-junit.xml -DCTEST_RC=<rc> -DSECS=<s> -DCLEAN=sim|nao
#         -DAPP=ON|OFF [-DBASE=main] -DOUT=<build>/gate-resumo.txt -P ci/resumo.cmake
# Escreve um resumo que se compara lado a lado entre ramos: ramo, SHA, build limpa, contagem por label, cada teste com
# a duracao, e o inventario. Sai com erro (o gate fica VERMELHO) quando:
#   - um teste da lista ci/testes.txt nao existe no ctest, ou tem outras labels, ou o ctest tem um teste fora da lista;
#   - um teste que existe em BASE (por omissao main) desapareceu;
#   - o ctest falhou, nao correu nenhum teste, ou o junit nao existe.
cmake_minimum_required(VERSION 3.21)
foreach(v SRC BUILD JUNIT CTEST_RC OUT)
  if(NOT DEFINED ${v})
    message(FATAL_ERROR "resumo.cmake: falta -D${v}")
  endif()
endforeach()
if(NOT DEFINED BASE)
  set(BASE main)
endif()
if(NOT DEFINED CLEAN)
  set(CLEAN "?")
endif()
if(NOT DEFINED SECS)
  set(SECS "?")
endif()
set(problems "")
macro(problem text)
  list(APPEND problems "${text}")
endmacro()

# --- git: ramo, SHA, alteracoes por commitar
execute_process(COMMAND git -C "${SRC}" rev-parse --abbrev-ref HEAD OUTPUT_VARIABLE branch OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git -C "${SRC}" rev-parse HEAD OUTPUT_VARIABLE sha OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git -C "${SRC}" status --porcelain OUTPUT_VARIABLE dirty OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(sha STREQUAL "")
  set(sha "?")
  problem("sem SHA: o codigo nao e um repositorio git (um verde sem SHA nao conta)")
endif()
if(branch STREQUAL "")
  set(branch "?")
endif()
set(dirtyText "")
if(NOT dirty STREQUAL "")
  set(dirtyText " (COM ALTERACOES POR COMMITAR: este verde nao e de nenhum commit)")
endif()

# --- o que o ctest tem (nome -> labels)
execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${BUILD}" --show-only=json-v1 OUTPUT_VARIABLE shown RESULT_VARIABLE rc ERROR_QUIET)
set(have "")
if(NOT rc EQUAL 0)
  problem("ctest --show-only falhou (${rc})")
else()
  string(JSON n LENGTH "${shown}" tests)
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      string(JSON name GET "${shown}" tests ${i} name)
      set(labels "")
      string(JSON np ERROR_VARIABLE noProps LENGTH "${shown}" tests ${i} properties)
      if(NOT noProps AND np GREATER 0)
        math(EXPR lp "${np} - 1")
        foreach(j RANGE ${lp})
          string(JSON pn GET "${shown}" tests ${i} properties ${j} name)
          if(pn STREQUAL "LABELS")
            string(JSON nl LENGTH "${shown}" tests ${i} properties ${j} value)
            math(EXPR ll "${nl} - 1")
            foreach(k RANGE ${ll})
              string(JSON lab GET "${shown}" tests ${i} properties ${j} value ${k})
              list(APPEND labels "${lab}")
            endforeach()
          endif()
        endforeach()
      endif()
      list(SORT labels)
      list(APPEND have "${name}")
      set("labels_${name}" "${labels}")
    endforeach()
  endif()
endif()

# --- a lista (ci/testes.txt)
file(STRINGS "${SRC}/ci/testes.txt" lines)
set(expected "")
set(appOnly 0)
set(appMissing "")
foreach(line IN LISTS lines)
  string(STRIP "${line}" line)
  if(line STREQUAL "" OR line MATCHES "^#")
    continue()
  endif()
  string(REGEX REPLACE "[ \t]+" ";" parts "${line}")
  list(GET parts 0 name)
  list(GET parts 1 want)
  string(REPLACE "," ";" want "${want}")
  list(SORT want)
  list(LENGTH parts np)
  set(isApp FALSE)
  if(np GREATER 2)
    list(GET parts 2 flag)
    if(flag STREQUAL "app")
      set(isApp TRUE)
    endif()
  endif()
  list(APPEND expected "${name}")
  if(NOT name IN_LIST have)
    if(isApp AND NOT APP)
      list(APPEND appMissing "${name}")
    else()
      problem("${name} esta em ci/testes.txt mas nao existe no ctest")
    endif()
  elseif(NOT "${labels_${name}}" STREQUAL "${want}")
    string(REPLACE ";" "," a "${labels_${name}}")
    string(REPLACE ";" "," b "${want}")
    problem("${name}: labels ${a}, a lista diz ${b}")
  endif()
endforeach()
foreach(name IN LISTS have)
  if(NOT name IN_LIST expected)
    problem("${name} existe no ctest mas nao esta em ci/testes.txt (um teste novo entra na lista no mesmo commit)")
  endif()
endforeach()

# --- nenhum teste de BASE desaparece (os add_test de BASE:tests/CMakeLists.txt e a lista de BASE, se tiver)
set(baseNames "")
set(baseText "")
execute_process(COMMAND git -C "${SRC}" show "${BASE}:tests/CMakeLists.txt" OUTPUT_VARIABLE baseCm RESULT_VARIABLE r1 ERROR_QUIET)
if(r1 EQUAL 0)
  string(REGEX MATCHALL "add_test\\(NAME [A-Za-z0-9_]+" found "${baseCm}")
  foreach(f IN LISTS found)
    string(REPLACE "add_test(NAME " "" f "${f}")
    list(APPEND baseNames "${f}")
  endforeach()
  execute_process(COMMAND git -C "${SRC}" show "${BASE}:ci/testes.txt" OUTPUT_VARIABLE baseList RESULT_VARIABLE r2 ERROR_QUIET)
  if(r2 EQUAL 0)
    string(REGEX MATCHALL "(^|\n)[A-Za-z0-9_]+" found "${baseList}")
    foreach(f IN LISTS found)
      string(STRIP "${f}" f)
      list(APPEND baseNames "${f}")
    endforeach()
  endif()
  list(REMOVE_DUPLICATES baseNames)
  list(LENGTH baseNames baseCount)
  list(LENGTH expected nowCount)
  set(gone "")
  foreach(name IN LISTS baseNames)
    if(NOT name IN_LIST expected)
      list(APPEND gone "${name}")
      problem("${name} existia em ${BASE} e desapareceu (exige decisao numerada no ESTADO.md)")
    endif()
  endforeach()
  set(baseText "vs ${BASE}: ${baseCount} -> ${nowCount}")
else()
  set(baseText "vs ${BASE}: sem comparacao (${BASE} nao existe neste clone)")
endif()

# --- o que correu (junit do ctest)
set(rows "")
set(ran 0)
set(passed 0)
set(allLabels "")
if(NOT EXISTS "${JUNIT}")
  problem("sem resultado do ctest (${JUNIT} nao existe)")
else()
  file(READ "${JUNIT}" xml)
  string(REGEX MATCHALL "<testcase name=\"[^\"]*\" classname=\"[^\"]*\" time=\"[^\"]*\" status=\"[^\"]*\"" cases "${xml}")
  foreach(c IN LISTS cases)
    string(REGEX REPLACE ".*name=\"([^\"]*)\".*time=\"([^\"]*)\".*status=\"([^\"]*)\".*" "\\1;\\2;\\3" f "${c}")
    list(GET f 0 name)
    list(GET f 1 t)
    list(GET f 2 st)
    math(EXPR ran "${ran} + 1")
    if(st STREQUAL "run")
      set(mark "ok  ")
      math(EXPR passed "${passed} + 1")
    else()
      set(mark "FAIL")
    endif()
    # duracao com 2 casas
    string(REGEX MATCH "^[0-9]+" whole "${t}")
    string(REGEX MATCH "\\.([0-9][0-9]?)" frac "${t}")
    string(REGEX REPLACE "^\\." "" frac "${frac}")
    if(frac STREQUAL "")
      set(frac "00")
    endif()
    string(LENGTH "${frac}" fl)
    if(fl EQUAL 1)
      set(frac "${frac}0")
    endif()
    set(labs "${labels_${name}}")
    foreach(l IN LISTS labs)
      list(APPEND allLabels "${l}")
      if(NOT DEFINED "ran_${l}")
        set("ran_${l}" 0)
        set("ok_${l}" 0)
      endif()
      math(EXPR "ran_${l}" "${ran_${l}} + 1")
      if(st STREQUAL "run")
        math(EXPR "ok_${l}" "${ok_${l}} + 1")
      endif()
    endforeach()
    string(REPLACE ";" "," labsText "${labs}")
    set(padded "${name}                    ")
    string(SUBSTRING "${padded}" 0 20 padded)
    list(APPEND rows "  ${mark} ${padded} ${whole}.${frac} s  [${labsText}]")
  endforeach()
  if(ran EQUAL 0)
    problem("o ctest nao correu nenhum teste")
  elseif(passed LESS ran)
    math(EXPR failed "${ran} - ${passed}")
    problem("${failed} teste(s) falharam")
  endif()
endif()
if(NOT CTEST_RC EQUAL 0)
  problem("o ctest saiu com ${CTEST_RC}")
endif()

list(REMOVE_DUPLICATES allLabels)
list(SORT allLabels)
set(byLabel "")
foreach(l IN LISTS allLabels)
  list(APPEND byLabel "${l} ${ok_${l}}/${ran_${l}}")
endforeach()
string(REPLACE ";" " | " byLabel "${byLabel}")

list(LENGTH expected listCount)
list(LENGTH appMissing nAppMissing)
set(appText "")
if(nAppMissing GREATER 0)
  string(REPLACE ";" ", " am "${appMissing}")
  set(appText " (sem app nesta build, nao corridos: ${am})")
endif()

if(problems STREQUAL "")
  set(verdict "VERDE")
else()
  set(verdict "VERMELHO")
endif()
set(text "Gate do Core: ${verdict}
ramo / SHA: ${branch} / ${sha}${dirtyText}
build limpa: ${CLEAN} (${BUILD})
gate: ${byLabel} | total ${passed}/${ran} | duracao: ${SECS} s
inventario: ${listCount} testes em ci/testes.txt${appText}; ${baseText}
testes:
")
foreach(r IN LISTS rows)
  string(APPEND text "${r}\n")
endforeach()
if(NOT problems STREQUAL "")
  string(APPEND text "problemas:\n")
  foreach(p IN LISTS problems)
    string(APPEND text "  - ${p}\n")
  endforeach()
endif()
file(WRITE "${OUT}" "${text}")
message("${text}")
if(NOT problems STREQUAL "")
  message(FATAL_ERROR "gate VERMELHO")
endif()
