# Verificacoes do ci/gate.ps1 que a cloud consegue fazer sem PowerShell (os bugs apanhados no PC a 2026-11-16):
#   1. o .bat temporario tem um nome por corrida, nunca um caminho fixo em %TEMP% (dois gates em paralelo colidiam);
#   2. nenhuma variavel com o nome de um parametro noutra caixa ($clean e o [switch]$Clean: o PowerShell nao distingue);
#   3. o JUCE_BUILDNUMBER le-se sem _VERSION.
#   cmake -DGATE=<ci/gate.ps1> -P tests/gate_static.cmake
if(NOT DEFINED GATE)
  message(FATAL_ERROR "gate_static: falta -DGATE")
endif()
file(READ "${GATE}" text)
set(problems "")
if(text MATCHES "Join-Path \\$env:TEMP \"[^\"]*\\.bat\"")
  list(APPEND problems "o .bat do gate tem um nome fixo em %TEMP% (dois gates em paralelo reescrevem-no)")
endif()
# Parametros do param(...) e atribuicoes "$nome =" fora de comentarios, comparados sem caixa.
string(REGEX MATCH "param\\(([^)]*)\\)" block "${text}")
string(REGEX MATCHALL "\\$[A-Za-z_]+" params "${CMAKE_MATCH_1}")
file(STRINGS "${GATE}" lines)
foreach(line IN LISTS lines)
  string(REGEX REPLACE "#.*$" "" code "${line}")
  string(REGEX MATCHALL "\\$[A-Za-z_]+[ \t]*=[^=]" sets "${code}")
  foreach(s IN LISTS sets)
    string(REGEX REPLACE "[ \t]*=.*$" "" var "${s}")
    foreach(p IN LISTS params)
      string(TOLOWER "${p}" pl)
      string(TOLOWER "${var}" vl)
      if(pl STREQUAL vl AND NOT p STREQUAL var)
        list(APPEND problems "${var} e o parametro ${p} (o PowerShell nao distingue maiusculas): ${line}")
      endif()
    endforeach()
  endforeach()
endforeach()
if(text MATCHES "JUCE_\\$\\{_\\}_VERSION")
  list(APPEND problems "a versao do JUCE procura JUCE_BUILDNUMBER_VERSION, que nao existe")
endif()
if(NOT problems STREQUAL "")
  foreach(p IN LISTS problems)
    message("  ${p}")
  endforeach()
  message(FATAL_ERROR "gate_static: ${GATE} tem problemas")
endif()
message(STATUS "gate_static: ok")
