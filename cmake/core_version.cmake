# Writes core_version.h: the Core version plus the git commit it was built from, so every build (and every
# report, log or sweep made with it) says exactly which code it is. Run at every build by the core_version
# target; the header only changes (and only rebuilds what uses it) when the commit or the version changes.
#   cmake -DSOURCE=<repo> -DOUT=<file> -DVERSION=<x.y.z> -P core_version.cmake
set(hash "unknown")
set(date "")
set(dirty 0)
find_package(Git QUIET)
if(GIT_FOUND)
  execute_process(COMMAND ${GIT_EXECUTABLE} -C ${SOURCE} rev-parse --short=10 HEAD
                  OUTPUT_VARIABLE out RESULT_VARIABLE rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(rc EQUAL 0 AND out)
    set(hash "${out}")
    execute_process(COMMAND ${GIT_EXECUTABLE} -C ${SOURCE} log -1 --format=%cs
                    OUTPUT_VARIABLE date OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    # Uncommitted changes to tracked files: the build is not exactly that commit.
    execute_process(COMMAND ${GIT_EXECUTABLE} -C ${SOURCE} status --porcelain --untracked-files=no
                    OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(changes)
      set(dirty 1)
    endif()
  endif()
endif()
set(build "${VERSION}+${hash}")
if(dirty)
  set(build "${build}.modified")
endif()
set(text "// Generated by cmake/core_version.cmake at build time. Do not edit.
#pragma once
#define CORE_VERSION \"${VERSION}\"
#define CORE_GIT_HASH \"${hash}\"
#define CORE_GIT_DATE \"${date}\"
#define CORE_GIT_MODIFIED ${dirty}
// What reports quote: version + commit (+ .modified when built with uncommitted changes).
#define CORE_BUILD_ID \"${build}\"
")
set(old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
  file(WRITE "${OUT}" "${text}")
endif()
